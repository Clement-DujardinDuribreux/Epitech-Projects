# Doxygen configuration for the Zappy project

PROJECT_NAME           = "Zappy"
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO

OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES

INPUT                  = README.md ai/main.py ai/src ai/docs network/docs network/include network/src gui/main.cpp gui/src gui/docs docs
IMAGE_PATH             = docs
RECURSIVE              = YES
FILE_PATTERNS          = *.py *.c *.cpp *.cc *.h *.hpp *.md
EXCLUDE                = docs/doxygen tests
EXCLUDE_PATTERNS       = */__pycache__/*

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES

GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_EXTRA_STYLESHEET  = ./docs/doxygen-awesome.css
HTML_FILE_EXTENSION    = .html
GENERATE_TREEVIEW      = YES

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO

HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
CALL_GRAPH             = YES
CALLER_GRAPH           = YES

MARKDOWN_SUPPORT       = YES
MARKDOWN_ID_STYLE      = GITHUB
AUTOLINK_SUPPORT       = YES
PYTHON_DOCSTRING       = YES
JAVADOC_AUTOBRIEF      = YES

GENERATE_TAGFILE       = 
