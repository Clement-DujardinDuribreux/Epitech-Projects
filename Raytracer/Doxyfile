# Doxygen configuration for raytracer project

PROJECT_NAME           = "Raytracer"
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO

OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES

INPUT                  = src README.md docs
USE_MDRANKS            = YES
IMAGE_PATH             = docs
RECURSIVE              = YES
FILE_PATTERNS          = *.c *.cpp *.cc *.h *.hpp
EXCLUDE                = 

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO

GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_EXTRA_STYLESHEET  = ./docs/doxygen-awesome.css
HTML_FILE_EXTENSION    = .html
HTML_TIMESTAMP         = NO
GENERATE_TREEVIEW      = YES
GENERATE_SEARCHENGINE  = YES

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO

HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
CALL_GRAPH             = YES
CALLER_GRAPH           = YES

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

GENERATE_TAGFILE       = 
